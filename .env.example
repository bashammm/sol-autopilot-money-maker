# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Solana RPC Providers (Failover order: QuickNode -> Alchemy -> Helius)
# Credentials kept strictly server-side; never exposed to browser, git, or logs.
QUICKNODE_SOLANA_RPC_URL=""
ALCHEMY_SOLANA_RPC_URL=""
HELIUS_SOLANA_RPC_URL=""

# Supabase / Postgres Persistence (Optional cloud override; defaults to ACID local ledger with RLS)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Security & Webhook verification
WEBHOOK_SIGNING_SECRET=""
SYSTEM_AUTH_KEY=""

# Optional: Funded Solana Keypair (Base58 string or JSON byte array) to sign and broadcast real on-chain disbursements/sweeps
TREASURY_PRIVATE_KEY=""
